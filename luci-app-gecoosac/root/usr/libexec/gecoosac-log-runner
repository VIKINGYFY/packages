#!/bin/sh

output=file

if [ "${1:-}" = '--syslog' ]; then
	output=syslog
	shift
else
	log_file="$1"
	shift
fi

check_interval="${GECOOSAC_LOG_CHECK_INTERVAL:-30}"
max_log_size=$((20 * 1048576))
max_backups=3

if [ "$output" = file ]; then
	case "$log_file" in
		/*/gecoosac.log) ;;
		*) exit 1 ;;
	esac
fi
case "$check_interval" in
	''|*[!0-9]*|0) exit 1 ;;
esac
umask 077

rotate_log() {
	local size
	local index

	[ -f "$log_file" ] || return 0
	size="$(wc -c < "$log_file")" || return 1
	[ "$size" -gt "$max_log_size" ] 2>/dev/null || return 0

	rm -f "$log_file.$max_backups"
	index=$((max_backups - 1))
	while [ "$index" -ge 1 ]; do
		[ ! -f "$log_file.$index" ] || mv -f \
			"$log_file.$index" "$log_file.$((index + 1))"
		index=$((index - 1))
	done
	cp -p "$log_file" "$log_file.1" || return 1
	: > "$log_file"
}

timestamp_output() {
	local line timestamp

	while IFS= read -r line || [ -n "$line" ]; do
		timestamp="$(date '+%Y/%m/%d %H:%M:%S')"
		if [ "$output" = syslog ]; then
			logger -t gecoosac "$timestamp $line"
		else
			printf '%s %s\n' "$timestamp" "$line"
		fi
	done < "$fifo"
}

if [ "$output" = file ]; then
	rotate_log || exit 1
fi

runtime_dir="$(mktemp -d /tmp/gecoosac-log.XXXXXX)" || exit 1
fifo="$runtime_dir/output"
cleanup_runtime() {
	rm -f "$fifo"
	rmdir "$runtime_dir"
}

mkfifo "$fifo" || {
	cleanup_runtime
	exit 1
}

if [ "$output" = syslog ]; then
	timestamp_output &
else
	timestamp_output >> "$log_file" &
fi
writer_pid=$!

"$@" > "$fifo" 2>&1 &
child_pid=$!

monitor_log() {
	while kill -0 "$child_pid" 2>/dev/null; do
		sleep "$check_interval" || return 0
		rotate_log
	done
}

if [ "$output" = file ]; then
	monitor_log &
	monitor_pid=$!
fi

forward_term() {
	kill -TERM "$child_pid" 2>/dev/null
}

forward_signal() {
	forward_term
	trap - INT TERM
}

trap forward_signal INT TERM
wait "$child_pid"
status=$?
if [ -n "${monitor_pid:-}" ]; then
	kill "$monitor_pid" 2>/dev/null
	wait "$monitor_pid" 2>/dev/null
fi
wait "$writer_pid"
[ "$output" = file ] && rotate_log
cleanup_runtime
exit "$status"
