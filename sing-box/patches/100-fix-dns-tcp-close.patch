+func HandleStreamDNSConnection(ctx context.Context, router adapter.DNSRouter, conn net.Conn, metadata adapter.InboundContext) error {
+	var responses sync.WaitGroup
+	for {
+		conn.SetReadDeadline(time.Now().Add(C.DNSTimeout))
+		err := handleStreamDNSRequest(ctx, router, conn, metadata, &responses)
+		if err != nil {
+			if errors.Is(err, io.EOF) {
+				// A peer may stop sending before its outstanding responses arrive.
+				conn.SetWriteDeadline(time.Now().Add(C.DNSTimeout))
+				responses.Wait()
+			}
+			return err
+		}
+	}
+}
