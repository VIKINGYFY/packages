+// DeleteDataDirectory removes one exclusively owned local payload directory.
+// Callers must first establish that its record has no surviving child references.
+func (s *DataStorageService) DeleteDataDirectory(ctx context.Context, ds *ent.DataStorage, key string) error {
+	if ds.Type != datastorage.TypeFs {
+		return fmt.Errorf("recursive deletion requires local FS storage")
+	}
+	key = filepath.Clean(filepath.FromSlash(key))
+	if key == "/" || key == "." {
+		return fmt.Errorf("refusing to remove storage root")
+	}
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	fs, err := s.GetFileSystem(ctx, ds)
+	if err != nil {
+		return err
+	}
+	return fs.RemoveAll(key)
+}
+
+// writeLocalAtomic never truncates the published file. A failed write/close/sync
+// leaves the previous version untouched and removes the private temporary file.
+func writeLocalAtomic(ctx context.Context, fs afero.Fs, key string, reader io.Reader) (int64, error) {
+	if err := ctx.Err(); err != nil {
+		return 0, err
+	}
+	dir := filepath.Dir(key)
+	if err := fs.MkdirAll(dir, 0o700); err != nil {
+		return 0, fmt.Errorf("create payload directory: %w", err)
+	}
+	f, err := afero.TempFile(fs, dir, ".axonhub-*")
+	if err != nil {
+		return 0, fmt.Errorf("create payload temporary file: %w", err)
+	}
+	defer fs.Remove(f.Name())
+	n, writeErr := io.Copy(f, reader)
+	if writeErr == nil {
+		writeErr = ctx.Err()
+	}
+	if writeErr == nil {
+		writeErr = f.Sync()
+	}
+	closeErr := f.Close()
+	if err := errors.Join(writeErr, closeErr); err != nil {
+		return n, fmt.Errorf("write payload: %w", err)
+	}
+	if err := fs.Rename(f.Name(), key); err != nil {
+		return n, fmt.Errorf("publish payload: %w", err)
+	}
+	// Flush the rename. This complements file Sync; it cannot guarantee the
+	// behavior of an eMMC controller under power loss.
+	parent, err := fs.Open(dir)
+	if err != nil {
+		return n, fmt.Errorf("open payload directory: %w", err)
+	}
+	syncErr := parent.Sync()
+	closeErr = parent.Close()
+	if err := errors.Join(syncErr, closeErr); err != nil {
+		return n, fmt.Errorf("sync payload directory: %w", err)
+	}
+	return n, nil
+}
+
