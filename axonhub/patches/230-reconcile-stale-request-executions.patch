+// clearStaleProcessing only finalizes records before both the supplied process
+// boundary and the grace period. Periodic callers need exclusive DB ownership.
+func (s *RequestService) clearStaleProcessing(ctx context.Context, startedAt time.Time) error {
+	const batchSize = 128
+	cutoff := time.Now().UTC().Add(-maxProcessingDuration)
+	videoFormats := make([]string, 0, 3)
+	for format := range llm.CapableAPIFormats(llm.RequestTypeVideo) {
+		videoFormats = append(videoFormats, format)
+	}
+	oldRequest := request.And(
+		request.CreatedAtLT(startedAt),
+		request.CreatedAtLT(cutoff),
+		// A provider video task can remain active across local restarts.
+		request.Not(request.And(request.FormatIn(videoFormats...), request.ExternalIDNotNil(), request.ExternalIDNEQ(""))),
+	)
+	unsettledRequest := request.StatusIn(request.StatusPending, request.StatusProcessing)
+	unsettledExecution := requestexecution.StatusIn(requestexecution.StatusPending, requestexecution.StatusProcessing)
+	var requestCount, executionCount int
+	_, err := authz.RunAsHost(ctx, s.entFromContext(ctx), "cleanup-stale-requests", func(ctx context.Context) (struct{}, error) {
+		for {
+			n := 0
+			err := s.RunInTransaction(ctx, func(txCtx context.Context) error {
+				client := s.entFromContext(txCtx)
+				ids, err := client.Request.Query().Where(oldRequest, unsettledRequest).
+					Order(ent.Asc(request.FieldID)).Limit(batchSize).IDs(txCtx)
+				if err != nil || len(ids) == 0 {
+					return err
+				}
+				execs, err := client.RequestExecution.Update().
+					Where(requestexecution.RequestIDIn(ids...), unsettledExecution,
+						requestexecution.CreatedAtLT(startedAt), requestexecution.CreatedAtLT(cutoff)).
+					SetStatus(requestexecution.StatusCanceled).Save(txCtx)
+				if err != nil {
+					return err
+				}
+				n, err = client.Request.Update().Where(request.IDIn(ids...), unsettledRequest).
+					SetStatus(request.StatusCanceled).Save(txCtx)
+				if err == nil {
+					requestCount += n
+					executionCount += execs
+				}
+				return err
+			})
+			if err != nil {
+				return struct{}{}, err
+			}
+			if n < batchSize {
+				break
+			}
+		}
+
+		// A completed main request can still have an unfinished older execution
+		// from an interrupted persistence operation. Reconcile it as well.
+		client := s.entFromContext(ctx)
+		for {
+			ids, err := client.RequestExecution.Query().Where(
+				unsettledExecution, requestexecution.CreatedAtLT(startedAt), requestexecution.CreatedAtLT(cutoff),
+				requestexecution.HasRequestWith(oldRequest,
+					request.StatusIn(request.StatusCanceled, request.StatusCompleted, request.StatusFailed)),
+			).Order(ent.Asc(requestexecution.FieldID)).Limit(batchSize).IDs(ctx)
+			if err != nil || len(ids) == 0 {
+				return struct{}{}, err
+			}
+			n, err := client.RequestExecution.Update().
+				Where(requestexecution.IDIn(ids...), unsettledExecution).
+				SetStatus(requestexecution.StatusCanceled).Save(ctx)
+			if err != nil {
+				return struct{}{}, err
+			}
+			executionCount += n
+			if len(ids) < batchSize {
+				return struct{}{}, nil
+			}
+		}
+	})
+	if err != nil {
+		return fmt.Errorf("cancel stale processing: %w", err)
+	}
+	if requestCount > 0 || executionCount > 0 {
+		log.Info(ctx, "canceled stale processing records", log.Int("requests", requestCount), log.Int("executions", executionCount))
 	}
 	return nil
 }
