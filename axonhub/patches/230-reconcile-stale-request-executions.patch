+// RegisterStaleProcessingCleanup schedules cleanup for a process with exclusive
+// ownership of its SQLite database. Calls must precede request admission.
+func (s *RequestService) RegisterStaleProcessingCleanup(ctx context.Context, schedulerService *scheduler.Scheduler) error {
+	startedAt := time.Now().UTC()
+	run := func(ctx context.Context) error {
+		ctx, cancel := context.WithTimeout(ctx, 30*time.Second)
+		defer cancel()
+		return s.clearStaleProcessing(ctx, startedAt)
+	}
+	if err := schedulerService.RegisterWithError(ctx, scheduler.TaskSpec{
+		Name:        "stale-processing",
+		Description: "Cancel abandoned requests from previous process runs",
+		FixRate:     15 * time.Minute,
+	}, run); err != nil {
+		return err
 	}
+	go func() {
+		defer func() {
+			if r := recover(); r != nil {
+				log.Error(context.Background(), "stale request cleanup panicked", log.Any("panic", r))
+			}
+		}()
+		if err := run(context.Background()); err != nil {
+			log.Warn(context.Background(), "failed to cancel stale processing records on startup", log.Cause(err))
+		}
+	}()
+	return nil
+}
 
