+// waitForBatch yields between batches and honors cancellation even when pacing is disabled.
+func (w *Worker) waitForBatch(ctx context.Context, pause bool) error {
+	if err := ctx.Err(); err != nil {
+		return err
+	}
+	if !pause || w.Config.BatchInterval <= 0 {
+		return nil
+	}
+	timer := time.NewTimer(w.Config.BatchInterval)
+	defer timer.Stop()
+	select {
+	case <-ctx.Done():
+		return ctx.Err()
+	case <-timer.C:
+		return nil
+	}
+}
 
+// runCleanup shares one admission lock between scheduled and manual maintenance.
+func (w *Worker) runCleanup(ctx context.Context, manual bool, manualDays map[string]int) error {
+	if err := ctx.Err(); err != nil {
