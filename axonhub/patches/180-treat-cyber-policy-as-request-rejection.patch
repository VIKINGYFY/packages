+func TestModelCircuitBreakerTracker_ContentPolicyRejectionPreservesHealth(t *testing.T) {
+	ctx := t.Context()
+	cb := biz.NewModelCircuitBreaker()
+	outbound := &PersistentOutboundTransformer{
+		state: &PersistenceState{
+			OriginalModel: "gpt-4",
+			RoutingPolicy: EffectiveRoutingPolicy{
+				LoadBalancerStrategy: biz.LoadBalancerStrategyCircuitBreaker,
+			},
+			CurrentCandidate: &ChannelModelsCandidate{
+				Channel: &biz.Channel{Channel: &ent.Channel{ID: 42}},
+			},
+		},
+	}
+	tracker := withModelCircuitBreaker(outbound, cb).(*modelCircuitBreakerTracker)
+	tracker.OnOutboundRawError(ctx, &httpclient.Error{
+		StatusCode: http.StatusUnavailableForLegalReasons,
+		Body:       []byte(`{"error":{"code":"provider_unavailable","message":"cyber_policy is not the error code"}}`),
+	})
+	before := cb.GetModelCircuitBreakerStats(ctx, 42, "gpt-4")
+	require.Equal(t, 1, before.ConsecutiveFailures)
+
+	tests := []struct {
+		name string
+		err  error
+	}{
+		{
+			name: "stream failure",
+			err: &llm.ResponseError{
+				StatusCode: http.StatusBadRequest,
+				Detail:     llm.ErrorDetail{Code: llm.ErrorCodeCyberPolicy, Type: "invalid_request"},
+			},
+		},
+		{
+			name: "HTTP 451 from provider",
+			err: &httpclient.Error{
+				StatusCode: http.StatusUnavailableForLegalReasons,
+				Body:       []byte(`{"error":{"code":"cyber_policy","type":"invalid_request","message":"request rejected"}}`),
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			for range biz.DefaultModelCircuitBreakerPolicy().OpenThreshold {
+				tracker.OnOutboundRawError(ctx, tt.err)
+			}
+
+			after := cb.GetModelCircuitBreakerStats(ctx, 42, "gpt-4")
+			require.Equal(t, biz.StateClosed, after.State)
+			require.Equal(t, before.ConsecutiveFailures, after.ConsecutiveFailures)
+			require.Equal(t, before.LastFailureAt, after.LastFailureAt)
+		})
+	}
+}
