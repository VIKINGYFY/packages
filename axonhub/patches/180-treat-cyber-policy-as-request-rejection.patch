+// ErrorCodeCyberPolicy identifies a request rejected by the upstream content policy.
+const ErrorCodeCyberPolicy = "cyber_policy"
+
+// IsContentPolicyRejection recognizes the upstream code in HTTP and stream errors.
+func IsContentPolicyRejection(err error) bool {
+	if responseErr, ok := errors.AsType[*ResponseError](err); ok {
+		return responseErr != nil && responseErr.Detail.Code == ErrorCodeCyberPolicy
+	}
+
+	// Raw error middleware runs before the HTTP error is transformed.
+	httpErr, ok := errors.AsType[*httpclient.Error](err)
+	if !ok || httpErr == nil {
+		return false
+	}
+
+	var responseErr ResponseError
+	return json.Unmarshal(httpErr.Body, &responseErr) == nil &&
+		responseErr.Detail.Code == ErrorCodeCyberPolicy
+}
