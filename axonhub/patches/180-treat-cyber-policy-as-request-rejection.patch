+func TestPipelineResponsesContentPolicyRejectionDoesNotRetry(t *testing.T) {
+	tests := []struct {
+		name               string
+		sameChannelRetries int
+	}{
+		{name: "same channel and failover available", sameChannelRetries: 1},
+		{name: "failover available"},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			realResponses, err := openairesponses.NewOutboundTransformer("https://api.openai.com", "test-api-key")
+			require.NoError(t, err)
+
+			attempts, prepareCalls := 0, 0
+			executor := &retryTestExecutor{
+				attempts: &attempts,
+				streams: [][]*httpclient.StreamEvent{
+					{{Type: "response.failed", Data: []byte(`{"type":"response.failed","response":{"error":{"type":"invalid_request","code":"cyber_policy","message":"request rejected"}}}`)}},
+					{
+						{Type: "response.output_text.delta", Data: []byte(`{"type":"response.output_text.delta","delta":"ok"}`)},
+						{Type: "response.completed", Data: []byte(`{"type":"response.completed","response":{"status":"completed"}}`)},
+					},
+				},
+			}
+			outbound := &retryTestFailover{
+				retryTestOutbound: &retryTestOutbound{
+					real:         realResponses,
+					prepareCalls: &prepareCalls,
+					canRetry:     func(error) bool { return true },
+				},
+			}
+			p := llmpipeline.NewFactory(executor).Pipeline(&retryTestInbound{}, outbound, llmpipeline.WithRetry(1, tt.sameChannelRetries, 0))
+
+			_, err = p.Process(t.Context(), &httpclient.Request{})
+			var responseErr *llm.ResponseError
+			require.ErrorAs(t, err, &responseErr)
+			require.Equal(t, http.StatusBadRequest, responseErr.StatusCode)
+			require.Equal(t, llm.ErrorCodeCyberPolicy, responseErr.Detail.Code)
+			require.Equal(t, "invalid_request", responseErr.Detail.Type)
+			require.NotErrorIs(t, err, llm.ErrEmptyResponse)
+			require.Equal(t, 1, attempts)
+			require.Zero(t, prepareCalls)
+			require.False(t, outbound.switched)
+		})
+	}
+}
