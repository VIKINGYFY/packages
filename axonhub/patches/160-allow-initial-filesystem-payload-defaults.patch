--- /dev/null
+++ b/internal/server/biz/system_initial_storage.go
@@ -0,0 +1,43 @@
+package biz
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/looplj/axonhub/internal/ent"
+	"github.com/looplj/axonhub/internal/objects"
+)
+
+// InitialStorageConfig is applied only when creating a new AxonHub instance.
+// An empty directory leaves the deployment's database storage mode unchanged.
+type InitialStorageConfig struct {
+	PayloadDirectory string `conf:"payload_directory" yaml:"payload_directory" json:"payload_directory"`
+}
+
+func (s *SystemService) initializePayloadStorage(ctx context.Context, tx *ent.Tx) (int, error) {
+	cfg := s.InitialStorage
+	if !filepath.IsAbs(cfg.PayloadDirectory) || filepath.Clean(cfg.PayloadDirectory) == string(filepath.Separator) {
+		return 0, fmt.Errorf("initial_storage.payload_directory must be an absolute directory other than the filesystem root")
+	}
+	if err := os.MkdirAll(cfg.PayloadDirectory, 0o700); err != nil {
+		return 0, fmt.Errorf("create initial payload directory: %w", err)
+	}
+
+	storage, err := tx.DataStorage.Create().
+		SetName("Local Payloads").
+		SetDescription("Local filesystem payload storage").
+		SetType("fs").
+		SetSettings(&objects.DataStorageSettings{Directory: &cfg.PayloadDirectory}).
+		SetStatus("active").
+		Save(ctx)
+	if err != nil {
+		return 0, fmt.Errorf("create initial filesystem payload storage: %w", err)
+	}
+
+	if err := s.SetStoragePolicy(ctx, &defaultStoragePolicy); err != nil {
+		return 0, fmt.Errorf("set initial payload retention policy: %w", err)
+	}
+	return storage.ID, nil
+}
