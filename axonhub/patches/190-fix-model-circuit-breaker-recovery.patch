+func TestModelCircuitBreaker_ExpiredProbeCannotChangeReplacement(t *testing.T) {
+	ctx := t.Context()
+	cb := NewModelCircuitBreaker()
+	const model = "gpt-test"
+	oldNormal, _ := cb.BeginAttempt(ctx, 1, model)
+	for range cb.GetPolicy(ctx).OpenThreshold {
+		cb.RecordError(ctx, 1, model)
+	}
+	stats := cb.getStats(1, model)
+	stats.Lock()
+	stats.NextProbeAt = time.Now().Add(-time.Second)
+	stats.Unlock()
+
+	const requests = 32
+	results := make(chan *ModelCircuitAttempt, requests)
+	var concurrent sync.WaitGroup
+	for range requests {
+		concurrent.Go(func() {
+			attempt, _ := cb.BeginAttempt(ctx, 1, model)
+			results <- attempt
+		})
+	}
+	concurrent.Wait()
+	close(results)
+	var first *ModelCircuitAttempt
+	for attempt := range results {
+		if attempt != nil {
+			require.Nil(t, first)
+			first = attempt
+		}
+	}
+	require.NotNil(t, first)
+
+	stats.Lock()
+	stats.probeUntil = time.Now().Add(-time.Second)
+	stats.Unlock()
+	replacement, _ := cb.BeginAttempt(ctx, 1, model)
+	require.NotNil(t, replacement)
+
