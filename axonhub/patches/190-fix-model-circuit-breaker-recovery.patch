+func (m *ModelCircuitBreaker) GetEffectiveWeight(ctx context.Context, channelID int, modelID string, baseWeight float64) float64 {
+	stats, ok := m.modelStats.Load(m.ChannelModelKey(channelID, modelID))
+	if !ok {
+		return baseWeight
+	}
+	stats.Lock()
+	defer stats.Unlock()
+
+	now := time.Now()
+	m.expireFailuresLocked(ctx, stats, now)
+	if !stats.retryAt(now).IsZero() {
+		return 0
+	}
+	if stats.State == StateOpen {
+		// Give an eligible probe a chance against healthy peers at the same
+		// priority. BeginAttempt still admits only one concurrent probe.
+		return baseWeight * 2
+	}
+	if stats.State == StateClosed {
+		return baseWeight
+	}
+	return baseWeight * m.GetPolicy(ctx).HalfOpenWeight
