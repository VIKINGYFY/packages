+// Do not spend a priority, sticky, or retry slot on a route in cooldown.
+func filterCircuitCandidates(
+	ctx context.Context,
+	breaker *biz.ModelCircuitBreaker,
+	candidates []*ChannelModelsCandidate,
+	retryAt *time.Time,
+) []*ChannelModelsCandidate {
+	available := make([]*ChannelModelsCandidate, 0, len(candidates))
+	for _, candidate := range candidates {
+		if candidate == nil || candidate.Channel == nil || len(candidate.Models) == 0 {
+			continue
+		}
+		pairedFormats := len(candidate.modelAPIFormats) == len(candidate.Models)
+		var filtered *ChannelModelsCandidate
+		for i, model := range candidate.Models {
+			next := breaker.RetryAt(ctx, candidate.Channel.ID, model.ActualModel)
+			if !next.IsZero() {
+				if retryAt.IsZero() || next.Before(*retryAt) {
+					*retryAt = next
+				}
+				if filtered == nil {
+					copy := *candidate
+					copy.Models = slices.Clone(candidate.Models[:i])
+					if pairedFormats {
+						copy.modelAPIFormats = slices.Clone(candidate.modelAPIFormats[:i])
+					}
+					filtered = &copy
+				}
+				continue
+			}
+			if filtered != nil {
+				filtered.Models = append(filtered.Models, model)
+				if pairedFormats {
+					filtered.modelAPIFormats = append(filtered.modelAPIFormats, candidate.modelAPIFormats[i])
+				}
+			}
+		}
+		if filtered == nil {
+			available = append(available, candidate)
+		} else if len(filtered.Models) > 0 {
+			if pairedFormats {
+				filtered.APIFormat = filtered.modelAPIFormats[0]
+			}
+			available = append(available, filtered)
+		}
+	}
+	return available
+}
