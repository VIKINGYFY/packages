From: VIKINGYFY <viking.yfy@qq.com>
Date: Tue, 13 Oct 2026 20:27:48 +0800
Subject: [PATCH] storage: default all history cleanup options to one day

Enable each built-in cleanup option with one-day retention for new
instances. Keep explicit stored policy values unchanged. Align the
frontend initial controls and manual cleanup dialog with these defaults.

The initialized cleanup state contains all five resources; use their
configured values directly when opening manual cleanup instead of
substituting unrelated runtime retention values.

Base-Commit: 6c137e3162c20c4663437233ae3bf56f0724d7db

---

--- a/frontend/src/features/system/components/storage-policy-settings.tsx
+++ b/frontend/src/features/system/components/storage-policy-settings.tsx
@@ -95,9 +95,9 @@ function groupBodyPreviewItems(items: Gc
 
 const DEFAULT_CLEANUP_OPTIONS: CleanupOption[] = [
-  { resourceType: 'requests', enabled: false, cleanupDays: 3 },
-  { resourceType: 'usage_logs', enabled: false, cleanupDays: 30 },
-  { resourceType: 'request_bodies', enabled: false, cleanupDays: 7 },
-  { resourceType: 'response_bodies', enabled: false, cleanupDays: 7 },
-  { resourceType: 'response_chunks', enabled: false, cleanupDays: 3 },
+  { resourceType: 'requests', enabled: true, cleanupDays: 1 },
+  { resourceType: 'usage_logs', enabled: true, cleanupDays: 1 },
+  { resourceType: 'request_bodies', enabled: true, cleanupDays: 1 },
+  { resourceType: 'response_bodies', enabled: true, cleanupDays: 1 },
+  { resourceType: 'response_chunks', enabled: true, cleanupDays: 1 },
 ];
 
@@ -121,5 +121,5 @@ function upsertCleanupOption(
 ): CleanupOption[] {
   if (!options.some((option) => option.resourceType === resourceType)) {
-    return [...options, { resourceType, enabled: false, cleanupDays: 7, ...patch }];
+    return [...options, { resourceType, enabled: true, cleanupDays: 1, ...patch }];
   }
 
@@ -147,9 +147,9 @@ export function StoragePolicySettings()
   });
 
-  const [manualRequestsDays, setManualRequestsDays] = useState(30);
-  const [manualUsageLogsDays, setManualUsageLogsDays] = useState(7);
-  const [manualRequestBodiesDays, setManualRequestBodiesDays] = useState(7);
-  const [manualResponseBodiesDays, setManualResponseBodiesDays] = useState(7);
-  const [manualResponseChunksDays, setManualResponseChunksDays] = useState(3);
+  const [manualRequestsDays, setManualRequestsDays] = useState(1);
+  const [manualUsageLogsDays, setManualUsageLogsDays] = useState(1);
+  const [manualRequestBodiesDays, setManualRequestBodiesDays] = useState(1);
+  const [manualResponseBodiesDays, setManualResponseBodiesDays] = useState(1);
+  const [manualResponseChunksDays, setManualResponseChunksDays] = useState(1);
   const [previewItems, setPreviewItems] = useState<GcCleanupPreviewItem[]>([]);
   const [isPreviewLoading, setIsPreviewLoading] = useState(false);
@@ -257,9 +257,9 @@ export function StoragePolicySettings()
 
     {
-      const reqDays = cleanupOption(storagePolicyState.cleanupOptions, 'requests')?.cleanupDays || 30;
-      const usageDays = cleanupOption(storagePolicyState.cleanupOptions, 'usage_logs')?.cleanupDays || 7;
-      const requestBodyDays = cleanupOption(storagePolicyState.cleanupOptions, 'request_bodies')?.cleanupDays || 7;
-      const responseBodyDays = cleanupOption(storagePolicyState.cleanupOptions, 'response_bodies')?.cleanupDays || 7;
-      const chunkDays = cleanupOption(storagePolicyState.cleanupOptions, 'response_chunks')?.cleanupDays || 3;
+      const reqDays = cleanupOption(storagePolicyState.cleanupOptions, 'requests')!.cleanupDays;
+      const usageDays = cleanupOption(storagePolicyState.cleanupOptions, 'usage_logs')!.cleanupDays;
+      const requestBodyDays = cleanupOption(storagePolicyState.cleanupOptions, 'request_bodies')!.cleanupDays;
+      const responseBodyDays = cleanupOption(storagePolicyState.cleanupOptions, 'response_bodies')!.cleanupDays;
+      const chunkDays = cleanupOption(storagePolicyState.cleanupOptions, 'response_chunks')!.cleanupDays;
       setManualRequestsDays(reqDays);
       setManualUsageLogsDays(usageDays);
